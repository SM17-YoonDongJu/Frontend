{
  "name": "@insurance/web",
  "version": "0.0.0",
  "private": true,
  "description": "보험 플랫폼 웹 (Next.js App Router)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "generate:api": "openapi-ts -f openapi-ts.config.ts && node scripts/patch-generated-zod.mjs",
    "spec:pull": "node scripts/spec-snapshot.mjs --write",
    "spec:check": "node scripts/spec-snapshot.mjs --check"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@insurance/bridge": "workspace:*",
    "@lukemorales/query-key-factory": "^1.3.4",
    "@react-pdf/renderer": "^4.5.1",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-query-devtools": "^5.101.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "^16.2.7",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "react-error-boundary": "^6.1.2",
    "react-hook-form": "^7.79.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@hey-api/client-fetch": "^0.13.1",
    "@hey-api/openapi-ts": "^0.99.0",
    "@insurance/config": "workspace:*",
    "@playwright/test": "^1.61.0",
    "@storybook/addon-a11y": "10.4.4",
    "@storybook/addon-docs": "10.4.4",
    "@storybook/nextjs-vite": "10.4.4",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "msw": "^2.14.6",
    "oxlint": "^1.72.0",
    "prettier": "^3.3.0",
    "storybook": "10.4.4",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.4.0",
    "vite": "^8.0.16"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
