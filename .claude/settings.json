{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/api-spec-lint.sh\"",
            "statusMessage": "API 명세 계약 검사"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/fractal-boundary-lint.sh\"",
            "statusMessage": "프렉탈 경계 검사"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/px-rem-lint.sh\"",
            "statusMessage": "길이값 px→rem 검사"
          }
        ]
      }
    ]
  }
}
